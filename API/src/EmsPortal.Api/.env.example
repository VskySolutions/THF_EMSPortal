# EMS Portal API - local secrets.
#
# Copy this file to `.env` in the same folder (Visual Studio / `dotnet run`), or next to EmsPortal.Api.dll on a
# server. Every line is loaded into the process environment before configuration is built, so ANY appsettings
# key can be set here with `__` in place of `:`. A real environment variable with the same name wins over this
# file. `.env` is git-ignored: never commit it.

# ---- Microsoft 365 sign-in ("Login with Microsoft") ----
# From the Entra ID app registration: Overview -> Directory (tenant) ID and Application (client) ID;
# Certificates & secrets -> a client secret's Value. Register the redirect URI (platform "Web") as
#   https://<api-host>/api/auth/microsoft/callback     (dev: http://localhost:5032/api/auth/microsoft/callback)
# Leave all three empty to keep the button switched off.
Authentication__Microsoft__TenantId=
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=

# Only when the API sits behind a proxy and cannot see its public scheme/host: the exact redirect URI registered above.
# Authentication__Microsoft__RedirectUri=

# Optional: `select_account` always shows Microsoft's account picker instead of signing a signed-in account straight in.
# Authentication__Microsoft__Prompt=
