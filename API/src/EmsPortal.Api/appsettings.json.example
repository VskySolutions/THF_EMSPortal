{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "BaseUrl": ""
  },
  "ErrorHandling": {
    "IncludeExceptionDetails": false
  },
  "ConnectionStrings": {
    "SqlServer": "Data Source=<server>;Initial Catalog=<database>;User Id=<user>;Password=<password>;MultipleActiveResultSets=True;TrustServerCertificate=True;"
  },
  "Hangfire": {
    "WorkerCount": 10,
    "DashboardEnabled": true,
    "SchemaName": "HangFire",
    "ServerName": ""
  },
  "Authentication": {
    "Issuer": "",
    "Audience": "",
    "PublicKeyPem": "",
    "SigningKey": "",
    "ApiKeyHeaderName": "X-Api-Key",
    "ClockSkewSeconds": 30,
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "ApiKeys": {
    "Keys": []
  },
  "Rems": {
    "ApprovalPolicy": {
      "StaticRouting": true,
      "ManagingShareholder": "Jeff Barbacci",
      "TaxExceptionCses": [ "James Previte", "Stephen Hamic" ],
      "TaxFeeCeilingWithoutManagingShareholder": 10000
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": []
  }
}
