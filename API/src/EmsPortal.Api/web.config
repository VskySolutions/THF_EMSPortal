<?xml version="1.0" encoding="utf-8"?>
<!--
  Published next to EmsPortal.Api.dll; the publish step adds the aspNetCore handler to it.
  IIS refuses a request body over maxAllowedContentLength before the API ever sees it, so this sits above
  Limits:Uploads:MaxRequestBodyMb in appsettings.json (50 MB here) and the appsettings value is the one that counts.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
