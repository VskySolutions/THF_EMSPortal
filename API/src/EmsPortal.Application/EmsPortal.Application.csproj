<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EmsPortal.Shared\EmsPortal.Shared.csproj" />
    <ProjectReference Include="..\EmsPortal.Domain\EmsPortal.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Google Fonts catalogue the branding rules validate a chosen font against. -->
    <EmbeddedResource Include="Branding\google-fonts.json" LogicalName="google-fonts.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
